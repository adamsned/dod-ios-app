[{"id":6805,"post":21238,"parent":0,"author":0,"author_name":"Maria","author_url":"","date":"2026-05-04T07:42:50","date_gmt":"2026-05-04T13:42:50","content":{"rendered":"<p><img class=\"wprm-comment-rating\" src=\"https:\/\/www.dutchovendaddy.com\/wp-content\/plugins\/wp-recipe-maker\/assets\/icons\/rating\/stars-alt-5.svg\" alt=\"5 stars\" width=\"80\" height=\"16\" \/><br \/>\nI love how quick and easy this recipe is to pull together. The corn stays crisp and juicy while soaking up all that wonderful garlic butter goodness. It has become my favorite way to prepare corn because it takes so little time but tastes like it came from a fancy steakhouse.<\/p>\n"},"link":"https:\/\/www.dutchovendaddy.com\/garlic-butter-skillet-corn\/comment-page-1\/#comment-6805","status":"approved","type":"comment","author_avatar_urls":{"24":"https:\/\/secure.gravatar.com\/avatar\/fb90fcd2e2917c217b9b4634f5d004bc564881140a4a7934fb1ff98c5601182b?s=24&d=mm&r=g","48":"https:\/\/secure.gravatar.com\/avatar\/fb90fcd2e2917c217b9b4634f5d004bc564881140a4a7934fb1ff98c5601182b?s=48&d=mm&r=g","96":"https:\/\/secure.gravatar.com\/avatar\/fb90fcd2e2917c217b9b4634f5d004bc564881140a4a7934fb1ff98c5601182b?s=96&d=mm&r=g"},"meta":{"wprm_comment_rating":5},"_links":{"self":[{"href":"https:\/\/www.dutchovendaddy.com\/wp-json\/wp\/v2\/comments\/6805","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/www.dutchovendaddy.com\/wp-json\/wp\/v2\/comments"}],"up":[{"embeddable":true,"post_type":"post","href":"https:\/\/www.dutchovendaddy.com\/wp-json\/wp\/v2\/posts\/21238"}]}},{"id":6804,"post":21238,"parent":0,"author":0,"author_name":"Jason","author_url":"","date":"2026-05-04T07:42:24","date_gmt":"2026-05-04T13:42:24","content":{"rendered":"<p><img class=\"wprm-comment-rating\" src=\"https:\/\/www.dutchovendaddy.com\/wp-content\/plugins\/wp-recipe-maker\/assets\/icons\/rating\/stars-alt-5.svg\" alt=\"5 stars\" width=\"80\" height=\"16\" \/><br \/>\nThis is a fantastic side dish that works with a