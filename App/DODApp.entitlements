<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications capability (DUT-6 cause #3). CloudKit live-change
	  pushes (NSPersistentCloudKitContainer's CKDatabaseSubscription) are only
	  DELIVERED when the app carries the aps-environment entitlement; without it
	  the other device updates on its next launch/foreground instead of
	  instantly. The signing-neutral half (UIBackgroundModes: remote-notification
	  in Info.plist) was already present (T-701/T-702); this is the half that
	  needs the App ID provisioned for Push.

	  Value is "development" on purpose: it is what Xcode's Push Notifications
	  capability writes for the everyday Debug/device-dev state. Xcode AUTOMATICALLY
	  rewrites it to "production" when archiving for App Store / TestFlight,
	  because a distribution provisioning profile's aps-environment allowlist
	  always contains production. So this one committed value is correct for both
	  Debug and the Release-archive CD (automatic signing) - do not hardcode
	  "production" here or local/dev-signed builds would carry the wrong APNs env.

	  HARD PREREQUISITE: the App ID com.dutchovendaddy.DODApp must have Push
	  Notifications enabled in the Apple Developer portal and the provisioning
	  profile regenerated BEFORE a signed/CD build can carry this entitlement -
	  automatic signing cannot provision aps-environment for an App ID that lacks
	  the capability. See this PR's description and Marketing/TestFlight.md.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.dutchovendaddy.DODApp</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.dutchovendaddy.DODApp</string>
	</array>
</dict>
</plist>
