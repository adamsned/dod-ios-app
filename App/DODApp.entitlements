<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push Notifications capability (DUT-6 cause #3). CloudKit live-change
	  pushes (NSPersistentCloudKitContainer's CKDatabaseSubscription) are only
	  DELIVERED when the app carries the aps-environment entitlement; without it
	  the other device updates on its next launch/foreground instead of
	  instantly. The signing-neutral half (UIBackgroundModes: remote-notification
	  in Info.plist) was already present (T-701/T-702); this is the half that
	  needs the App ID provisioned for Push.

	  Value is "development" on purpose: it is what Xcode's Push Notifications
	  capability writes for the everyday Debug/device-dev state. Xcode AUTOMATICALLY
	  rewrites it to "production" when archiving for App Store / TestFlight,
	  because a distribution provisioning profile's aps-environment allowlist
	  always contains production. So this one committed value is correct for both
	  Debug and the Release-archive CD (automatic signing) - do not hardcode
	  "production" here or local/dev-signed builds would carry the wrong APNs env.

	  HARD PREREQUISITE: the App ID com.dutchovendaddy.DODApp must have Push
	  Notifications enabled in the Apple Developer portal and the provisioning
	  profile regenerated BEFORE a signed/CD build can carry this entitlement -
	  automatic signing cannot provision aps-environment for an App ID that lacks
	  the capability. See this PR's description and Marketing/TestFlight.md.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.dutchovendaddy.DODApp</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.dutchovendaddy.DODApp</string>
	</array>
	<!--
	  Sign in with Apple capability (US-46 / DUT-16 Phase a). Required by App
	  Store Review Guideline 4.8 once any third-party login ships, and the
	  provider the login feature lands first. "Default" is the standard value
	  Xcode's "Sign in with Apple" capability writes (a single primary Apple ID
	  relationship, no app-group sharing of the credential).

	  HARD PREREQUISITE (same shape as aps-environment above): the App ID
	  com.dutchovendaddy.DODApp must have the "Sign in with Apple" capability
	  enabled in the Apple Developer portal and the provisioning profile
	  regenerated BEFORE a signed/CD build can carry this entitlement — automatic
	  signing cannot provision it for an App ID that lacks the capability.
	  Simulator (Debug) builds are unsigned and run without the provisioned
	  capability, so local sim testing of the button works regardless.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!--
	  Associated Domains — Universal Links (DUT-1325). Lets a tapped
	  dutchovendaddy.com link open in the app (on the matching recipe/article)
	  instead of Safari. `applinks:` covers both the apex and www host because
	  DOD serves the site on both; iOS fetches each host's
	  apple-app-site-association (AASA) file to verify the association.

	  HARD PREREQUISITES (same shape as aps-environment / applesignin above),
	  BOTH required before this actually routes a link:
	    1. The App ID com.dutchovendaddy.DODApp must have the "Associated
	       Domains" capability enabled in the Apple Developer portal and the
	       provisioning profile regenerated — automatic signing cannot provision
	       `applinks` for an App ID that lacks the capability.
	    2. The site must serve the AASA file over HTTPS (no redirect) at
	       https://dutchovendaddy.com/.well-known/apple-app-site-association AND
	       the www host, listing "<TEAM_ID>.com.dutchovendaddy.DODApp". See
	       Marketing/universal-links.md for the file + WordPress runbook.

	  Simulator (Debug) builds are unsigned and strip entitlements, so Universal
	  Links can't be exercised on the sim — this needs a signed device build with
	  both prerequisites live.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:dutchovendaddy.com</string>
		<string>applinks:www.dutchovendaddy.com</string>
	</array>
</dict>
</plist>
