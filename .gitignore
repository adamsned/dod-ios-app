# Xcode
build/
DerivedData/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# XcodeGen — the project file is generated; we don't commit it
DODApp.xcodeproj/

# Swift Package Manager
.swiftpm/
.build/
Packages/*/.build/
Packages/*/.swiftpm/
Package.resolved

# Secrets (constitution §9)
*.xcconfig
!*.xcconfig.example
# App/DODApp.xcconfig is a committed signing *wrapper* (no secret) that
# project.yml's configFiles points to; it #include?s the gitignored
# App/DODApp.local.xcconfig which holds the Team ID. The wrapper MUST be
# tracked or CI's `xcodegen generate` fails with "Invalid config file".
!App/DODApp.xcconfig

# macOS
.DS_Store

# IDEs
.vscode/
.idea/

# Coverage / profiling
*.profraw
*.profdata

# Python (bin/ tooling such as the CI test-bug filer)
__pycache__/
*.pyc

# Fastlane (in case it gets added later)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
