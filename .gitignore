# Xcode
build/
build-sim/
DerivedData/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# XcodeGen — the project file is generated; we don't commit it, EXCEPT for
# one file: `Package.resolved` (see the Swift Package Manager section below
# for why). `xcodegen generate` never touches that file if it's already
# present (verified: survives a full regenerate byte-identical), so a
# committed copy at this exact path persists across every CI run.
DODApp.xcodeproj/*
!DODApp.xcodeproj/project.xcworkspace/
DODApp.xcodeproj/project.xcworkspace/*
!DODApp.xcodeproj/project.xcworkspace/xcshareddata/
DODApp.xcodeproj/project.xcworkspace/xcshareddata/*
!DODApp.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
DODApp.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!DODApp.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Swift Package Manager
.swiftpm/
.build/
Packages/*/.build/
Packages/*/.swiftpm/
# Bare `Package.resolved` still applies everywhere else (e.g. individual
# package checkouts) — only the one committed path above is exempted.
Package.resolved
!DODApp.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Secrets (constitution §9)
*.xcconfig
!*.xcconfig.example
# App/DODApp.xcconfig is a committed signing *wrapper* (no secret) that
# project.yml's configFiles points to; it #include?s the gitignored
# App/DODApp.local.xcconfig which holds the Team ID. The wrapper MUST be
# tracked or CI's `xcodegen generate` fails with "Invalid config file".
!App/DODApp.xcconfig

# macOS
.DS_Store

# IDEs
.vscode/
.idea/

# Coverage / profiling
*.profraw
*.profdata

# Python (bin/ tooling such as the CI test-bug filer)
__pycache__/
*.pyc

# Fastlane (in case it gets added later)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
.claude/
